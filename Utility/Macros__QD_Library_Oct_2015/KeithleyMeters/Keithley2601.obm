VERSION 1.0 OBJECT
BEGIN
  MultiUse = 0  'False
END
Attribute VB_PredeclaredId = True
Attribute VB_Creatable = True
Attribute VB_Exposed = True
Attribute VB_GlobalNameSpace = False
Attribute VB_Name = "Keithley2601"
'Keithley2601.obm
'Final Test Object

'Object to encapsulate communication to the Keithley 2182 nanovoltmeter
'Note that all functions are designed to return true if successful, false otherwise
'However, this functionality does not work because the GPIB functions don't return 0 when they fail.

'#Uses "..\Utils\Utils.obm"

Option Explicit

'Private  G As New GPIB 'don't allow outside user direct GPIB access.

Const Address As Integer = 26 'GPIB address of instrument

'function to initialize bridge. It will return False if not successful, true otherwise

Public Function Init() As Boolean
	Dim s As String
	Dim result As Integer
	'add SMU 2601 to GPIB
	result = GPIB.AddDevice(Address, 13, 1)
	'return codes from AddDevice are:
	 '   +ud - device handle
	 '    -101 - invalid argument
	 '   -102 - GPIB0 Not found
	 '   -103 - device already connected
	 '   -104 - device Not found
	 '   -105 - attempting To use PPMS
	 '     0  - NI Error code
	 '    -ni - NI Error code

	If (result < 0 And result <> -103) Then '< 0 indicates an error unless -103, which is already connected
		Init = False
		Exit Function
	End If

	'clear device. This seems to be necessary to get reliable communication
	If GPIB.SendString(Address, "*CLS"  & vbCrLf)<>1 Then
		Init = False
		Exit Function
	End If

	Init = True

End Function


'functions to configure the SMU 2601



'set V as source
'Arguments to be passed to the function:
'
' VSource = value in V of voltage source
' ILim = current limit in A
' IRange = current range in A
Public Function Config_setVasSource(ByVal VSource As Double, ByVal ILim As Double, ByVal IRange As Double) As Boolean
	'Reset machine
	GPIB.SendString(Address, "*RST" & vbCrLf)
	Wait(0.05)
	GPIB.SendString(Address, "*CLS" & vbCrLf)
	Wait(0.05)
	
	'Select voltage source function
	GPIB.SendString(Address, "smua.source.func = smua.OUTPUT_DCVOLTS" & vbCrLf)
	Wait(0.05)
	
	'Set voltage source
	GPIB.SendString(Address, "smua.source.levelv = " & VSource & vbCrLf)
	Wait(0.05)
	'Set current limit 
	GPIB.SendString(Address, "smua.source.limiti = " & ILim & vbCrLf)
	Wait(0.05)
	'Set current range 
	GPIB.SendString(Address, "smua.measure.rangei = " & IRange & vbCrLf)
	Wait(0.05)
	
	
	'Enable voltage source auto range
	GPIB.SendString(Address, "smua.source.autorangev = smua.AUTORANGE_ON" & vbCrLf)
	Wait(0.05)
	'Enable current measure auto range
	GPIB.SendString(Address, "smua.measure.autorangei = smua.AUTORANGE_ON" & vbCrLf)
	Wait(0.05)
	
	
	'Enable 2Wire resistance measurement
	GPIB.SendString(Address, "smua.sense = smua.SENSE_LOCAL" & vbCrLf)
	Wait(0.05)
	

	Config_setVasSource = True

End Function




'set I as source
'Arguments to be passed to the function:
'
' ISource = value in A of current source
' VLim = voltage limit in V
' IRange = current range in A
'
'2W for 2 wire ohm measurement
'4W for 4 wire ohm measurement
Public Function Config_setIasSource_2W(ByVal ISource As Double, ByVal VLim As Double, ByVal IRange As Double) As Boolean
	'Reset machine
	GPIB.SendString(Address, "*RST" & vbCrLf)
	Wait(0.05)
	GPIB.SendString(Address, "*CLS" & vbCrLf)
	Wait(0.05)
	
	'Select current source function
	GPIB.SendString(Address, "smua.source.func = smua.OUTPUT_DCAMPS" & vbCrLf)
	Wait(0.05)
	
	'Set current source
	GPIB.SendString(Address, "smua.source.leveli = " & ISource & vbCrLf)
	Wait(0.05)
	'Set voltage limit 
	GPIB.SendString(Address, "smua.source.limitv = " & VLim & vbCrLf)
	Wait(0.05)
	'Set current range 
	GPIB.SendString(Address, "smua.measure.rangei = " & IRange & vbCrLf)
	Wait(0.05)
	
	'Enable current source auto range
	GPIB.SendString(Address, "smua.source.autorangei = smua.AUTORANGE_ON" & vbCrLf)
	Wait(0.05)
	'Enable voltage measure auto range
	GPIB.SendString(Address, "smua.measure.autorangev = smua.AUTORANGE_ON" & vbCrLf)
	Wait(0.05)
	
	
	'Enable 2Wire resistance measurement
	GPIB.SendString(Address, "smua.sense = smua.SENSE_LOCAL" & vbCrLf)
	Wait(0.05)


	Config_setVasSource = True

End Function



Public Function Config_setIasSource_4W(ByVal ISource As Double, ByVal VLim As Double, ByVal IRange As Double) As Boolean
	'Reset machine
	GPIB.SendString(Address, "*RST" & vbCrLf)
	Wait(0.05)
	GPIB.SendString(Address, "*CLS" & vbCrLf)
	Wait(0.05)
	
	'Select current source function
	GPIB.SendString(Address, "smua.source.func = smua.OUTPUT_DCAMPS" & vbCrLf)
	Wait(0.05)
	
	'Set current source
	GPIB.SendString(Address, "smua.source.leveli = " & ISource & vbCrLf)
	Wait(0.05)
	'Set voltage limit 
	GPIB.SendString(Address, "smua.source.limitv = " & VLim & vbCrLf)
	Wait(0.05)
	'Set current range 
	GPIB.SendString(Address, "smua.measure.rangei = " & IRange & vbCrLf)
	Wait(0.05)
	
	'Enable current source auto range
	GPIB.SendString(Address, "smua.source.autorangei = smua.AUTORANGE_ON" & vbCrLf)
	Wait(0.05)
	'Enable voltage measure auto range
	GPIB.SendString(Address, "smua.measure.autorangev = smua.AUTORANGE_ON" & vbCrLf)
	Wait(0.05)
	
	'Enable 4Wire resistance measurement
	GPIB.SendString(Address, "smua.sense = smua.SENSE_REMOTE" & vbCrLf)
	Wait(0.05)


	Config_setVasSource = True

End Function



'function to read one resistance
'Arguments:
'V = variable that will contain the voltage reading
'I = variable that will contain the current reading
'Res = variable that will contain the resistance reading
Public Function ReadRes(ByRef V As Double, ByRef I As Double, Res As Double) As Boolean
	
	Wait(0.05)
	'Turn on output
	GPIB.SendString(Address, "smua.source.output = smua.OUTPUT_ON" & vbCrLf)
	Wait(0.1)
	'request voltage reading
	GPIB.SendString(Address, "reading = smuX.measure.v()" & vbCrLf)
	Wait(0.5)
	'put voltage reading in V
	GPIB.GetString(Address, V)
	
	Wait(0.1)
	'request current reading
	GPIB.SendString(Address, "reading = smuX.measure.i()" & vbCrLf)
	Wait(0.5)
	'put current reading in I
	GPIB.GetString(Address, I)
	
	Wait(0.1)
	'request resistance reading
	GPIB.SendString(Address, "reading = smuX.measure.r()" & vbCrLf)
	Wait(0.5)
	'put resistance reading in Res
	GPIB.GetString(Address, Res)
	
	Wait(0.05)
	'Turn off output
	GPIB.SendString(Address, "smua.source.output = smua.OUTPUT_OFF" & vbCrLf)
	Wait(0.1)

	ReadRes = True
End Function
