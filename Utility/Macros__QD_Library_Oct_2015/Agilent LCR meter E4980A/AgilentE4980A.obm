VERSION 1.0 OBJECT
BEGIN
  MultiUse = 0  'False
END
Attribute VB_PredeclaredId = True
Attribute VB_Creatable = True
Attribute VB_Exposed = True
Attribute VB_GlobalNameSpace = False
Attribute VB_Name = "E4980A"
'E4980Ae.obm
'Final Test Object

'Object to encapsulate communication to the Agilent E4908A LCR meter
'Note that all functions are designed to return true if successful, false otherwise
'However, this functionality does not work because the GPIB functions don't return 0 when they fail.

'#Uses "..\Utils\Utils.obm"
'#Uses "../MVUData/MVUData.cls"
'#uses "../Utils\PPMSUtils.obm"

Option Explicit

'Private  G As New GPIB 'don't allow outside user direct GPIB access.
Const Address As Integer = 17 'GPIB address of instrument

'function to initialize bridge. It will return False if not successful, true otherwise
Public Function Init() As Boolean
	Dim S As String
	Dim result As Integer
	'add LS bridge to GPIB
	result = GPIB.AddDevice(Address, 13, 1)
	'return codes from AddDevice are:
	 '   +ud - device handle
	 '    -101 - invalid argument
	 '   -102 - GPIB0 Not found
	 '   -103 - device already connected
	 '   -104 - device Not found
	 '   -105 - attempting To use PPMS
	 '     0  - NI Error code
	 '    -ni - NI Error code

	If (result < 0 And result <> -103) Then '< 0 indicates an error unless -103, which is already connected
		Init = False
		Exit Function
	End If

	'clear device. This seems to be necessary to get reliable communication
	If GPIB.SendString(Address, "*CLS" & vbLf)<>1 Then
		Init = False
		Exit Function
	End If

	Init = True

End Function


Public Function Magnetoresistance() As Boolean
	'Reset machine
	GPIB.SendString(Address, "*RST;*CLS" & vbLf)

	'Set voltage level applied to plates
	GPIB.SendString(Address,"SOUR:CUR:LEV 1" & vbLf)

	'Communicate using ASCII and not binary
	GPIB.SendString(Address, "FORM ASC" & vbLf)

	'Set measurement time to Long
	GPIB.SendString(Address, "APER MED,5" & vbLf)

	'Set trigger to be initiated by a signal from computer which means you must do an immediate trigger befor fetching!
	GPIB.SendString(Address, "TRIG:SOUR BUS" & vbLf)

	'Turn comparator on - just do it
	GPIB.SendString(Address, "COMP ON" & vbLf)

	'Continuous initiation on - just do it
	GPIB.SendString(Address, "INIT:CONT ON" & vbLf)

	'Initialize instrument
	GPIB.SendString(Address, "INIT:IMM" & vbLf)

	'Set meter to collect resistance and reactivity
	GPIB.SendString(Address, "FUNC:IMP RX" & vbLf)

	
	Magnetoresistance = True

End Function

'function to configure the LCR meter to take a single frequency measurement
Public Function OneFreqMeasurement() As Boolean
	'Reset machine
	GPIB.SendString(Address, "*RST;*CLS" & vbLf)

	'Set voltage level applied to plates
	GPIB.SendString(Address,"SOUR:CUR:LEV 1" & vbLf)

	'Communicate using ASCII and not binary
	GPIB.SendString(Address, "FORM ASC" & vbLf)

	'Set measurement time to medium
	GPIB.SendString(Address, "APER MED,5" & vbLf)

	'Set trigger to be initiated by a signal from computer which means you must do an immediate trigger befor fetching!
	GPIB.SendString(Address, "TRIG:SOUR BUS" & vbLf)

	'Turn comparator on - just do it
	GPIB.SendString(Address, "COMP ON" & vbLf)

	'Continuous initiation on - just do it
	GPIB.SendString(Address, "INIT:CONT ON" & vbLf)

	'Initialize instrument
	GPIB.SendString(Address, "INIT:IMM" & vbLf)

	'Set meter to collect capacitance and tan(delta)
	GPIB.SendString(Address, "FUNC:IMP CPD" & vbLf)

	OneFreqMeasurement = True

End Function
'function to configure the LCR meter to sweep a list of frequencies
Public Function FreqSweepMeasurement() As Boolean
	'Reset machine
	GPIB.SendString(Address, "*RST;*CLS" + vbLf)

	'Switch to sweep field page
	GPIB.SendString(Address, "DISP:PAGE LIST" + vbLf)

	'Communicate using ASCII and not binary
	GPIB.SendString(Address, "FORM ASC" + vbLf)

	'Configure instrument to operate in frequency sweep mode
	GPIB.SendString(Address, "LIST:MODE SEQ" + vbLf)

	'Set up a list
	GPIB.SendString(Address, "LIST:FREQ 20HZ,500HZ,1KHZ,5KHZ,10KHZ,25KHZ,50KHZ,75KHZ,100KHZ,250KHZ,500KHZ,750KHZ,1MHZ,1.5MHZ,2MHZ" + vbLf)
	GPIB.SendString(Address, "LIST:BAND1 A,100,200" + vbLf)
	GPIB.SendString(Address, "LIST:BAND2 A,100,200" + vbLf)
	GPIB.SendString(Address, "LIST:BAND3 A,100,200" + vbLf)
	GPIB.SendString(Address, "LIST:BAND4 A,100,200" + vbLf)
	GPIB.SendString(Address, "LIST:BAND5 A,100,200" + vbLf)
	GPIB.SendString(Address, "LIST:BAND6 A,100,200" + vbLf)
	GPIB.SendString(Address, "LIST:BAND7 A,100,200" + vbLf)
	GPIB.SendString(Address, "LIST:BAND8 A,100,200" + vbLf)
	GPIB.SendString(Address, "LIST:BAND9 A,100,200" + vbLf)
	GPIB.SendString(Address, "LIST:BAND10 A,100,200" + vbLf)
	GPIB.SendString(Address, "LIST:BAND11 A,100,200" + vbLf)
	GPIB.SendString(Address, "LIST:BAND12 A,100,200" + vbLf)
	GPIB.SendString(Address, "LIST:BAND13 A,100,200" + vbLf)
	GPIB.SendString(Address, "LIST:BAND14 A,100,200" + vbLf)
	GPIB.SendString(Address, "LIST:BAND15 A,100,200" + vbLf)

	'Set trigger to be initiated by a signal from computer which means you must do an immediate trigger befor fetching!
	GPIB.SendString(Address, "TRIG:SOUR BUS" & vbLf)

	'Continuous initiation on - just do it
	GPIB.SendString(Address, "INIT:CONT ON" + vbLf)

	'Set meter to collect capacitance and tan(delta)
	GPIB.SendString(Address, "FUNC:IMP CPD" & vbLf)

	FreqSweepMeasurement = True

End Function
Public Function ColeCole() As Boolean
	Dim i As Integer
	Dim junk As String

	'Reset machine
	GPIB.SendString(Address, "*RST;*CLS" + vbLf)

	'Switch to sweep field page
	GPIB.SendString(Address, "DISP:PAGE LIST" + vbLf)

	'Communicate using ASCII and not binary
	GPIB.SendString(Address, "FORM ASC" + vbLf)

	'Configure instrument to operate in frequency sweep mode
	GPIB.SendString(Address, "LIST:MODE STEP" + vbLf)

	'Original list
	'GPIB.SendString(Address, "LIST:FREQ 9.9E37,20.00,22.03,24.27,26.74,29.45,32.44,35.74,39.37,43.37,47.77,52.63,57.97,63.86,70.35,77.49,85.37,94.04,103.59,114.11,125.70,138.47,152.54,168.03,185.10,203.91,224.62,247.44,272.57,300.26,330.76,364.36,401.38,442.15,487.06,536.54,591.04,651.08,717.22,790.08,870.33,958.74,1056.13,1163.42,1281.60,1411.79,1555.20,1713.18,1887.21,2078.91,2290.10,2522.73,2778.99,3061.29,3372.26,3714.82,4092.18,4507.87,4965.79,5470.22,6025.90,6638.02,7312.32,8055.12,8873.37,9774.75,10767.69,11861.49,13066.40,14393.71,15855.85,17466.52,19240.81,21195.32,23348.39,25720.16,28332.87,31210.97,34381.44,37873.98,41721.29,45959.42,50628.07,55770.96,61436.29,67677.10,74551.87,82125.00,90467.41,99657.27,109780.65,120932.38,133216.93,146749.36,161656.44,178077.82,196167.31,216094.36,238045.65,262226.79,288864.29,318207.69,350531.84,386139.55,425364.35,468573.68,516172.31,568606.09,626366.20,689993.69,760084.59,837295.46,922349.55,1016043.61,1119255.29,1232951.41,1358197.01,1496165.29,1648148.66,1815570.80,2000000.00" + vbLf)

	'Set up a 200 pts (max for meter) logarithmically spaced list of frequencies to sweep
	GPIB.SendString(Address, "LIST:FREQ 9.9E37,20.00,22.03,24.27,29.45,32.44,35.74,39.37,43.37,47.77,52.63,57.97,63.86,70.35,77.49,85.37,94.04,103.59,114.11,125.70,138.47,152.54,168.03,185.10,203.91,224.62,247.44,272.57,300.26,330.76,364.36,401.38,442.15,487.06,536.54,591.04,651.08,717.22,790.08,870.33,958.74,1056.13,1163.42,1281.60,1411.79,1555.20,1713.18,1887.21,2078.91,2290.10,2522.73,2778.99,3061.29,3372.26,3714.82,4092.18,4507.87,4965.79,5470.22,6025.90,6638.02,7312.32,8055.12,8873.37,9774.75,10767.69,11861.49,13066.40,14393.71,15855.85,17466.52,19240.81,21195.32,23348.39,25720.16,28332.87,31210.97,34381.44,37873.98,41721.29,45959.42,50628.07,55770.96,61436.29,67677.10,74551.87,82125.00,90467.41,99657.27,109780.65,120932.38,133216.93,146749.36,161656.44,178077.82,196167.31,216094.36,238045.65,262226.79,288864.29,318207.69,350531.84,386139.55,425364.35,468573.68,516172.31,568606.09,626366.20,689993.69,760084.59,837295.46,922349.55,1016043.61,1119255.29,1232951.41,1358197.01,1496165.29,1648148.66,1815570.80,2000000.00" + vbLf)

	'For i = 1 To 6
	'	Debug.Print "tally = " & i
	'	GPIB.SendString(Address, "LIST:BAND" & i & " A,100,200" + vbLf)
		'Wait(5)
	'Next i

	'Set trigger to be initiated by a signal from computer which means you must do an immediate trigger befor fetching!
	GPIB.SendString(Address, "TRIG:SOUR BUS" & vbLf)

	'Continuous initiation on - just do it
	GPIB.SendString(Address, "INIT:CONT ON" + vbLf)

	'Set measurement time to medium
	GPIB.SendString(Address, "APER MED,5" & vbLf)

	'Set meter to collect impedence and theta in radians
	GPIB.SendString(Address, "FUNC:IMP ZTR" & vbLf)

    'Send trigger command
	GPIB.SendString(Address, "TRIG:IMM" & vbCrLf)
	Wait(0.005)
	'Send a request for data point
	GPIB.SendString(Address, "FETCh?" & vbCrLf)
	'Don't talk too fast
	Wait(0.005)

	'Retrieve data from instrument
	GPIB.GetString(Address, junk)

	ColeCole = True

End Function
